# Set the chosen passcode for each enabled role in private environment configuration.
OFFICER_PASSCODE=
# Optional viewer passcode; empty disables viewer login.
VIEWER_PASSCODE=
# Required: generate at least 32 random bytes. No built-in signing key.
SESSION_SECRET=

# OpenAI Responses API. Currently disabled in code (lib/extract.ts); Claude reads screenshots via the bridge.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5-mini

# Upstash Redis holds the shared tracker data. Vercel adds these when the Marketplace
# integration is connected. Leave empty locally to use .data/tracker-state.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# A private Vercel Blob store holds temporary screenshot uploads (and the tracker data
# when Redis is not connected). Vercel adds this automatically after the store is connected.
BLOB_READ_WRITE_TOKEN=
# Vercel may prefix the token with the store name instead.
BLOB1_READ_WRITE_TOKEN=

# Used by the scheduled five-day upload cleanup endpoint.
CRON_SECRET=

# Authenticates the local PC queue worker. If omitted, OFFICER_PASSCODE is used.
BRIDGE_SECRET=
# Required when using the PC worker: this customer's own deployment URL.
BRIDGE_URL=

# Starts the GitHub Actions bridge worker when a capture is queued. Fine-grained token
# limited to this repository with Contents: read and write. GITHUB_REPO is "owner/name".
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=
