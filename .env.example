# A lightweight shared passcode for officers. Required in production.
OFFICER_PASSCODE=change-me
SESSION_SECRET=replace-with-a-long-random-string

# OpenAI Responses API, used to read leaderboard screenshots.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5-mini

# One private Vercel Blob store holds shared tracker data and temporary uploads.
# Vercel adds this automatically after the store is connected to the project.
BLOB_READ_WRITE_TOKEN=
# Vercel may prefix the token with the store name instead.
BLOB1_READ_WRITE_TOKEN=

# Used by the scheduled five-day upload cleanup endpoint.
CRON_SECRET=
