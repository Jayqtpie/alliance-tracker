{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "taskForce": { "type": "string", "enum": ["A", "B", "unknown"] },
    "startersShown": { "type": "integer", "minimum": -1 },
    "subsShown": { "type": "integer", "minimum": -1 },
    "battleTime": { "type": "string" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "displayName": { "type": "string", "minLength": 1 },
          "heroPower": { "type": "integer", "minimum": 0 },
          "role": { "type": "string", "enum": ["starter", "sub"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "needsReview": { "type": "boolean" }
        },
        "required": ["displayName", "heroPower", "role", "confidence", "needsReview"]
      }
    }
  },
  "required": ["taskForce", "startersShown", "subsShown", "battleTime", "rows"]
}
